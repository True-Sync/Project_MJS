# Visual Studio 2015 user specific files
.vs/
.idea/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*
Plugins/**/Binaries/**/*.pdb

# FMOD Studio requires vendor runtime/link libraries to build on every machine.
# Keep only the SDK redistributables; generated UnrealEditor plugin DLL/PDB files
# remain ignored by the broader Binaries rules above.
!Plugins/FMODStudio/Binaries/
!Plugins/FMODStudio/Binaries/Win64/
!Plugins/FMODStudio/Binaries/Win64/fmod.dll
!Plugins/FMODStudio/Binaries/Win64/fmodL.dll
!Plugins/FMODStudio/Binaries/Win64/fmod_vc.lib
!Plugins/FMODStudio/Binaries/Win64/fmodL_vc.lib
!Plugins/FMODStudio/Binaries/Win64/fmodstudio.dll
!Plugins/FMODStudio/Binaries/Win64/fmodstudioL.dll
!Plugins/FMODStudio/Binaries/Win64/fmodstudio_vc.lib
!Plugins/FMODStudio/Binaries/Win64/fmodstudioL_vc.lib
!Plugins/FMODStudio/Binaries/Win64/fmod_haptics.dll
!Plugins/FMODStudio/Binaries/Win64/resonanceaudio.dll


# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
Plugins/FMODStudio/Binaries/Win64/UnrealEditor-FMODStudioEditor.pdb
Plugins/FMODStudio/Binaries/Win64/UnrealEditor-FMODStudio.pdb
*.slnx
.cursor
compile_commands.json
.clangd
.vscode
.ue5_8cursor
