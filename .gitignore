# Visual Studio 2015 user specific files
.vs/
.idea/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*
Plugins/**/Binaries/**/*.pdb

# FMOD Studio requires vendor runtime/link libraries to build on every machine.
# Keep only the SDK redistributables; generated UnrealEditor plugin DLL/PDB files
# remain ignored by the broader Binaries rules above.
!Plugins/FMODStudio/Binaries/
!Plugins/FMODStudio/Binaries/Win64/
!Plugins/FMODStudio/Binaries/Win64/fmod.dll
!Plugins/FMODStudio/Binaries/Win64/fmodL.dll
!Plugins/FMODStudio/Binaries/Win64/fmod_vc.lib
!Plugins/FMODStudio/Binaries/Win64/fmodL_vc.lib
!Plugins/FMODStudio/Binaries/Win64/fmodstudio.dll
!Plugins/FMODStudio/Binaries/Win64/fmodstudioL.dll
!Plugins/FMODStudio/Binaries/Win64/fmodstudio_vc.lib
!Plugins/FMODStudio/Binaries/Win64/fmodstudioL_vc.lib
!Plugins/FMODStudio/Binaries/Win64/fmod_haptics.dll
!Plugins/FMODStudio/Binaries/Win64/resonanceaudio.dll
!Plugins/FMODStudio/Binaries/Android/
!Plugins/FMODStudio/Binaries/Android/fmod.jar
!Plugins/FMODStudio/Binaries/Android/arm64-v8a/
!Plugins/FMODStudio/Binaries/Android/arm64-v8a/libfmod.so
!Plugins/FMODStudio/Binaries/Android/arm64-v8a/libfmodL.so
!Plugins/FMODStudio/Binaries/Android/arm64-v8a/libfmodstudio.so
!Plugins/FMODStudio/Binaries/Android/arm64-v8a/libfmodstudioL.so
!Plugins/FMODStudio/Binaries/Android/arm64-v8a/libresonanceaudio.so
!Plugins/FMODStudio/Binaries/Android/quest/
!Plugins/FMODStudio/Binaries/Android/quest/libfmod_haptics.so
!Plugins/FMODStudio/Binaries/Android/x86_64/
!Plugins/FMODStudio/Binaries/Android/x86_64/libfmod.so
!Plugins/FMODStudio/Binaries/Android/x86_64/libfmodL.so
!Plugins/FMODStudio/Binaries/Android/x86_64/libfmodstudio.so
!Plugins/FMODStudio/Binaries/Android/x86_64/libfmodstudioL.so
!Plugins/FMODStudio/Binaries/Android/x86_64/libresonanceaudio.so
!Plugins/FMODStudio/Binaries/Linux/
!Plugins/FMODStudio/Binaries/Linux/libfmod.so
!Plugins/FMODStudio/Binaries/Linux/libfmodL.so
!Plugins/FMODStudio/Binaries/Linux/libfmod_haptics.so
!Plugins/FMODStudio/Binaries/Linux/libfmodstudio.so
!Plugins/FMODStudio/Binaries/Linux/libfmodstudioL.so
!Plugins/FMODStudio/Binaries/Linux/libresonanceaudio.so
!Plugins/FMODStudio/Binaries/Mac/
!Plugins/FMODStudio/Binaries/Mac/libfmod.dylib
!Plugins/FMODStudio/Binaries/Mac/libfmodL.dylib
!Plugins/FMODStudio/Binaries/Mac/libfmod_haptics.dylib
!Plugins/FMODStudio/Binaries/Mac/libfmodstudio.dylib
!Plugins/FMODStudio/Binaries/Mac/libfmodstudioL.dylib
!Plugins/FMODStudio/Binaries/Mac/resonanceaudio.dylib
!Plugins/FMODStudio/Binaries/IOS/
!Plugins/FMODStudio/Binaries/IOS/libfmod_iphoneos.a
!Plugins/FMODStudio/Binaries/IOS/libfmodL_iphoneos.a
!Plugins/FMODStudio/Binaries/IOS/libfmodstudio_iphoneos.a
!Plugins/FMODStudio/Binaries/IOS/libfmodstudioL_iphoneos.a
!Plugins/FMODStudio/Binaries/IOS/libresonanceaudio.a
!Plugins/FMODStudio/Binaries/TVOS/
!Plugins/FMODStudio/Binaries/TVOS/libfmod_appletvos.a
!Plugins/FMODStudio/Binaries/TVOS/libfmodL_appletvos.a
!Plugins/FMODStudio/Binaries/TVOS/libfmodstudio_appletvos.a
!Plugins/FMODStudio/Binaries/TVOS/libfmodstudioL_appletvos.a

# Precompiled editor modules are engine-build artifacts, not FMOD redistributables.
Plugins/FMODStudio/Binaries/*/UnrealEditor.modules
Plugins/FMODStudio/Binaries/Linux/libUnrealEditor-*
Plugins/FMODStudio/Binaries/Mac/libUnrealEditor-*


# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
Plugins/FMODStudio/Binaries/Win64/UnrealEditor-FMODStudioEditor.pdb
Plugins/FMODStudio/Binaries/Win64/UnrealEditor-FMODStudio.pdb
*.slnx
.cursor
compile_commands.json
.clangd
.vscode
.ue5_8cursor

# UE5_8 Cursor — plugin-generated, do not commit
.vscode/
.cursor/
compile_commands.json
.clangd
.clang-format
.ue5_8cursor/
.ue58rider/
.cache
Plugins/FMODStudio/Binaries/Win64/UnrealEditor-Win64-DebugGame.modules
*.code-workspace
.agent
Plugins/.DS_Store
.DS_Store
Project_MJS.uproject.DotSettings.user
